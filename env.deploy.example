# Copy this file to .env.local BEFORE npm run build (Cloudways / production)
#
#   cp env.deploy.example .env.local
#   npm install && npm run build && npm start
#
# .env.local is not in Git (secrets stay on the server).

# ── Required: site lives in a subfolder on sftrainings.org ───────────────
NEXT_PUBLIC_BASE_PATH=/iso-14001-2026-transition

# ── Required: registration form → n8n → Google Sheet ─────────────────────
N8N_LEAD_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/iso14001-lead
NEXT_PUBLIC_N8N_LEAD_WEBHOOK_URL=https://damnart-ai-guladab.n8n-wsk.com/webhook/iso14001-lead

# ── Production build ─────────────────────────────────────────────────────
NODE_ENV=production

# ── Optional overrides (defaults are fine if omitted) ────────────────────
# NEXT_PUBLIC_SITE_LOGO=/logo-112.png
# NEXT_PUBLIC_SITE_ICON=/logo.png
# NEXT_PUBLIC_USE_CLOUDINARY_MODULE_VIDEOS=false
