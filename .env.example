# ── Logo & favicon (paths under public/ or full URLs) ─────────────────────
# NEXT_PUBLIC_SITE_LOGO=/logo-112.png
# NEXT_PUBLIC_SITE_ICON=/logo.png

# ── Section videos (full URLs or paths under public/) ─────────────────────
# NEXT_PUBLIC_HERO_VIDEO=
# NEXT_PUBLIC_HERO_POSTER=
# NEXT_PUBLIC_OVERVIEW_VIDEO=
# NEXT_PUBLIC_OVERVIEW_POSTER=
# NEXT_PUBLIC_FAQ_VIDEO=
# NEXT_PUBLIC_FAQ_VIDEO_POSTER=

# ── Curriculum module videos (Vercel without Cloudinary) ─────────────────
# Option A: MP4s in public/videos/ (commit files or deploy with them)
# NEXT_PUBLIC_MODULE_VIDEOS_PATH=/videos

# Option B: External CDN / storage base URL (recommended for Vercel)
# NEXT_PUBLIC_MODULE_VIDEOS_CDN_URL=https://your-cdn.example.com/videos

# Option C: Full URLs per file in lib/module-videos.manifest.json (commit to Git)

# Option D: Cloudinary (opt-in only — not used unless explicitly enabled)
# NEXT_PUBLIC_USE_CLOUDINARY_MODULE_VIDEOS=true
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dwnnakrrh
# NEXT_PUBLIC_CLOUDINARY_MODULE_FOLDER=iso14001-modules
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# n8n lead webhook (optional)
# N8N_LEAD_WEBHOOK_URL=
